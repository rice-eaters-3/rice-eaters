# Copy this file to .env beside server.js. It is read automatically at startup.
# Set your own password once (at least 24 UTF-8 bytes). Keep quotes around # or spaces.
STUDIO_ADMIN_PASSWORD=""
PORT=3000
HOST=0.0.0.0

# Optional: absolute directory for persistent room/save data.
# DATA_DIR=C:\rice-eaters-data

# Optional: Live2D image provider (user API keys are entered in the web UI).
# LIVE2D_IMAGE_MODEL=gpt-image-2.5-flare
# LIVE2D_AI_BASE_URL=https://api.openai.com/v1

# Optional WebRTC TURN relay for players behind restrictive NAT/firewalls.
# Supply short-lived credentials from your TURN provider (do not commit real credentials).
# Example shape: [{"urls":"turn:turn.example.net:3478?transport=udp","username":"user","credential":"secret"}]
# The server shares this ICE configuration only with authenticated room members.
# WEBRTC_ICE_SERVERS_JSON=[]
# Set to relay only after configuring TURN; this forces audio through the relay.
# WEBRTC_ICE_TRANSPORT_POLICY=all
